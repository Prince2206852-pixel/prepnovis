# ==========================================
# Spring
# ==========================================
SPRING_PROFILES_ACTIVE=prod

# ==========================================
# PostgreSQL
# ==========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST:5432/prepnovis
SPRING_DATASOURCE_USERNAME=YOUR_DB_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# ==========================================
# Redis / Valkey
# ==========================================
SPRING_DATA_REDIS_HOST=YOUR_REDIS_HOST
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=YOUR_VALKEY_PASSWORD
SPRING_DATA_REDIS_SSL_ENABLED=true

# ==========================================
# Kafka
# ==========================================
SPRING_KAFKA_BOOTSTRAP_SERVERS=YOUR_KAFKA_HOST:YOUR_KAFKA_PORT
SPRING_KAFKA_USERNAME=YOUR_KAFKA_USERNAME
SPRING_KAFKA_PASSWORD=YOUR_KAFKA_PASSWORD

# ==========================================
# JWT
# ==========================================
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# ==========================================
# Gemini
# ==========================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ==========================================
# Frontend / CORS
# ==========================================
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app

# ==========================================
# Email / Resend
# ==========================================
FEEDBACK_EMAIL=YOUR_FEEDBACK_EMAIL
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=YOUR_VERIFIED_SENDER_EMAIL